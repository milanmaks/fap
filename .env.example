# Required only for Gemini-powered chat (leave empty for local-demo fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# PostgreSQL for persistent mode (leave empty or unset to use in-memory demo repository)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fap

# Local storage configuration
UPLOAD_STORAGE_DRIVER=local
UPLOAD_STORAGE_LOCAL_DIR=.data/uploads

# Safety limits
MAX_UPLOAD_FILE_BYTES=52428800
MAX_UPLOAD_FILES=20
MAX_ZIP_ENTRIES=200
MAX_ZIP_EXPANDED_BYTES=262144000
MAX_RECORDS_PER_FRAGMENT=5000
MAX_PROFILE_RECORDS=100000
